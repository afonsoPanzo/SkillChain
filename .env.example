# Devnet only. Never put private keys here.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Program ID of the deployed "skillchain" program (Solana Playground, Devnet).
# While empty, the app runs on the in-memory mock data layer.
NEXT_PUBLIC_SKILLCHAIN_PROGRAM_ID=

# Set to "true" to force the in-memory mock even when a Program ID is set.
NEXT_PUBLIC_USE_MOCK=
